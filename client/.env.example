# Copy to .env (or set as environment variables) before running `npm run build`.
# NEXT_PUBLIC_* values are baked into the build: change them, then rebuild.

# Shown as a badge in the header (e.g. Development, Test, Production)
NEXT_PUBLIC_ENVIRONMENT=Development

# API URL used by the Next.js server (server-to-server, can be an internal address)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# API URL used by the browser. On IIS the API is usually the /REST application of the same site
NEXT_PUBLIC_EXTERNAL_API_BASE_URL=https://tiva.example.org/REST
# Public keys for verifying TIVA tokens (API /.well-known/jwks.json)
NEXT_PUBLIC_JKU_URL=http://localhost:5000/.well-known/jwks.json
# Public URL of this site, used for logout and 404 redirects
NEXT_PUBLIC_LAUNCH_BASE_URL=https://tiva.example.org

# Google reCAPTCHA site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Hosts (host[:port]) where the captcha is skipped, comma separated. Leave empty to always show it
NEXT_PUBLIC_CAPTCHA_DISABLED_HOSTS=

# Optional site settings. Leave empty to hide or omit the feature
# Domain added to usernames to build emails, e.g. hospital.org
NEXT_PUBLIC_EMAIL_DOMAIN=
# Embedded report on the Reports page (External User Report)
NEXT_PUBLIC_EXTERNAL_REPORT_URL=
# Feedback link in the header
NEXT_PUBLIC_FEEDBACK_URL=
# Copyright holder in the footer
NEXT_PUBLIC_ORGANIZATION_NAME=

# Development only: set to 0 to accept self-signed API certificates
# NODE_TLS_REJECT_UNAUTHORIZED=0
