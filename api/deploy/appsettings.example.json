{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "tiva.example.org",
  "Environment": "Production",

  "DatabaseSettings": {
    "DEFAULT": "Data Source=tcp:sql.example.org;Initial Catalog=TIVA;Integrated Security=True;Pooling=true;Max Pool Size=50;"
  },

  "AppSettings": {
    "SERVER_IP": "",
    "SERVER_CONTEXT": "",
    "SQL_TIMEOUT": "60",
    "APP_NAME": "TIVA",
    "ADMIN": "",
    "ADMIN_EMAIL": "tiva-admin@example.org",
    "SECRET_KEY": "<AES key, see examples/GenerateAESKey.ps1>",
    "DEBUG": "false",
    "SITE_URL": "https://tiva.example.org",
    "COOKIE_DOMAIN": "tiva.example.org",
    "RECAPTCHA_SECRET_KEY": "<Google reCAPTCHA secret key, pairs with the client's NEXT_PUBLIC_RECAPTCHA_SITE_KEY>",
    "AUTH_JKU_URL": "https://tiva.example.org/REST/.well-known/jwks.json"
  },

  "JwtAuthentication": {
    "SecurityKey": "<random 32 character string>",
    "ValidAudience": "https://tiva.example.org/",
    "ValidIssuer": "https://tiva.example.org/",
    "JWT_PRIVATE_KEY": "-----BEGIN PRIVATE KEY-----\n<key used to sign TIVA tokens>\n-----END PRIVATE KEY-----",
    "JWT_PUBLIC_KEY": "-----BEGIN CERTIFICATE-----\n<X.509 certificate for JWT_PRIVATE_KEY>\n-----END CERTIFICATE-----",
    "Kid": "tiva-api-auth"
  },

  "Ehr": {
    "Enabled": true,
    "DisplayName": "EHR",
    "ClientId": "<client ID from the EHR vendor app registration>",
    "Issuer": "https://ehr.example.org/oauth2",
    "JwksUrl": "https://ehr.example.org/oauth2/jwks",
    "MetadataUrl": "https://ehr.example.org/api/FHIR/R4/metadata",
    "AllowedIssuers": [ "https://ehr.example.org/api/FHIR/R4" ],
    "RedirectUrl": "https://tiva.example.org/REST/ehr/callback",
    "StandaloneRedirectUrl": "",
    "StandaloneAuthorizeUrl": "",
    "LaunchScope": "openid fhirUser profile launch",
    "StandaloneScope": "openid fhirUser profile",
    "EndpointDiscovery": "ByUrl",
    "MetadataHeaders": { "Epic-Client-ID": "{ClientId}" },
    "TokenRefreshMinutes": 45,
    "Routes": {
      "Launch": "ehr/launch",
      "Callback": "ehr/callback",
      "Complete": "ehr/complete",
      "StandaloneLaunch": "ehr/standalone",
      "StandaloneCallback": "ehr/standalone/callback"
    },
    "ClientRoutes": {
      "Loading": "auth/ehrloading",
      "Launched": "auth/ehrlaunch",
      "Failure": "Search",
      "StandaloneLaunched": ""
    },
    "ClientAssertion": {
      "PrivateKey": "-----BEGIN PRIVATE KEY-----\n<key TIVA signs EHR requests with>\n-----END PRIVATE KEY-----",
      "PublicCertificate": "-----BEGIN CERTIFICATE-----\n<X.509 certificate for PrivateKey, shared with the EHR vendor>\n-----END CERTIFICATE-----",
      "Kid": "ehr",
      "IncludeKidHeader": true,
      "Algorithm": "RS384",
      "LifetimeMinutes": 2
    },
    "LaunchParameters": {
      "CaseId": "SurgeryID",
      "FirstName": "ReporterFirstName",
      "LastName": "ReporterLastName"
    },
    "User": {
      "ClaimType": "preferred_username",
      "StripPrefixes": [],
      "FallbackSuffixes": [],
      "Lowercase": false,
      "AutoCreate": true,
      "DefaultRoleId": "2"
    },
    "StandaloneUser": {
      "ClaimType": "preferred_username",
      "StripPrefixes": [],
      "FallbackSuffixes": [],
      "Lowercase": true,
      "AutoCreate": false,
      "DefaultRoleId": "2"
    },
    "DataMapping": {
      "WeightLabel": "Weight",
      "HeightLabel": "Height",
      "AnesthesiaStartEvent": "Anesthesia Start",
      "AnesthesiaStopEvent": "Anesthesia Stop",
      "ProcedurePafIndex": 1
    }
  },

  "Ldap": {
    "Enabled": false,
    "Host": "ldap.example.org",
    "Port": 636,
    "UseSsl": true,
    "BaseDn": "dc=example,dc=org",
    "UserFilter": "(uid={0})",
    "BindDnTemplate": "cn={0},ou=people,{1}"
  },

  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.org",
    "Port": 25,
    "UseSsl": false,
    "From": "tiva@example.org",
    "Username": "",
    "Password": ""
  }
}
